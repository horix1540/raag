# Copy this file to `.env` and fill in what you use. `.env` is gitignored.

# --- Which backend answers and judges --------------------------------------
# ollama (local, no rate limits) | groq (fast, free tier) | gemini (free tier)
RAG_PROVIDER=ollama

# Ollama tags. Pull them with:  ollama pull llama3.1:8b
RAG_GENERATOR_MODEL=llama3.1:8b
RAG_JUDGE_MODEL=gemma2:latest
OLLAMA_BASE_URL=http://localhost:11434

# Cloud keys - only needed if RAG_PROVIDER is groq or gemini.
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=AIza...

# --- Confidence layer ------------------------------------------------------
# nli  = local cross-encoders, milliseconds, no API calls (default)
# llm  = DeepEval LLM-as-judge, slower but the reference standard
# both = run both and log the disagreement
RAG_SCORER=nli

# --- Hardware --------------------------------------------------------------
# Set to cpu if you have no NVIDIA GPU. Both fall back automatically.
RAG_EMBEDDING_DEVICE=cuda
RAG_NLI_DEVICE=cuda

# Keep DeepEval from phoning home with anonymous telemetry.
DEEPEVAL_TELEMETRY_OPT_OUT=YES
